  ],
  "supplementary_hypothesis": "H-4",
  "feature_definitions": {
    "FS-14-5-A": {
      "name": "path_structure",
      "description": "Path structure features (H-1)",
      "features": [
        {
          "feature_id": "FEAT-401",
          "name": "path_max_drawdown_20",
          "formula": "max(peak_to_trough_drawdown(close, 20))",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "path_structure"
        },
        {
          "feature_id": "FEAT-402",
          "name": "path_up_down_ratio_20",
          "formula": "count(ret > 0, 20) / max(count(ret < 0, 20), 1)",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "path_structure"
        },
        {
          "feature_id": "FEAT-403",
          "name": "path_largest_move_20",
          "formula": "max(|ret|, 20)",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "path_structure"
        }
      ]
    },
    "FS-14-5-B": {
      "name": "asymmetry",
      "description": "Return asymmetry features (H-2)",
      "features": [
        {
          "feature_id": "FEAT-411",
          "name": "return_skew_20",
          "formula": "scipy.stats.skew(daily_returns, 20)",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "asymmetry"
        },
        {
          "feature_id": "FEAT-412",
          "name": "return_kurt_20",
          "formula": "scipy.stats.kurtosis(daily_returns, 20)",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "asymmetry"
        },
        {
          "feature_id": "FEAT-413",
          "name": "downside_vol_20",
          "formula": "std(ret[ret < 0], 20) where ret < 0 in trailing 20 sessions",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "asymmetry"
        }
      ]
    },
    "FS-14-5-C": {
      "name": "macro_regime",
      "description": "Macro regime features (H-3)",
      "features": [
        {
          "feature_id": "FEAT-431",
          "name": "macro_dff_level",
          "formula": "DFF(D) — last available Fed Funds Rate observation",
          "window": 1,
          "inputs": [
            "DFF from FRED DS-000003"
          ],
          "information_family": "macro_regime"
        },
        {
          "feature_id": "FEAT-432",
          "name": "macro_dff_change_3m",
          "formula": "DFF(D) - DFF(D-63)",
          "window": 63,
          "inputs": [
            "DFF from FRED DS-000003"
          ],
          "information_family": "macro_regime"
        },
        {
          "feature_id": "FEAT-433",
          "name": "macro_unemployment_level",
          "formula": "UNRATE(D) — last available unemployment rate",
          "window": 1,
          "inputs": [
            "UNRATE from FRED DS-000003"
          ],
          "information_family": "macro_regime"
        },
        {
          "feature_id": "FEAT-434",
          "name": "macro_cpi_yoy",
          "formula": "CPI(D) / CPI(D-252) - 1",
          "window": 252,
          "inputs": [
            "CPI from FRED DS-000003"
          ],
          "information_family": "macro_regime"
        }
      ]
    },
    "FS-14-5-D": {
      "name": "vol_dynamics",
      "description": "Volatility dynamics (H-4, supplementary)",
      "features": [
        {
          "feature_id": "FEAT-421",
          "name": "vol_of_vol_20",
          "formula": "std(rolling_std(ret, 5), 20)",
          "window": 25,
          "inputs": [
            "close"
          ],
          "information_family": "vol_dynamics"
        },
        {
          "feature_id": "FEAT-422",
          "name": "vol_change_20",
          "formula": "vol_10(D-1) - vol_10(D-20)",
          "window": 20,
          "inputs": [
            "close"
          ],
          "information_family": "vol_dynamics"
        }
      ]
    }
  },
  "datasets": {
    "primary": "DS-EXP-050 (ENV-050, ~50 instruments)",
