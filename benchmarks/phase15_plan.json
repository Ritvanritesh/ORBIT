  "datasets": {
    "prediction_source": "DS-EXP-050 test period (2022-01-03 to 2026-06-30)",
    "feature_snapshots": "Locked per model feature_set and universe",
    "prediction_selection": {
      "method": "stratified_quantile",
      "categories": [
        "top_1pct_prediction",
        "bottom_1pct_prediction",
        "near_zero_prediction",
        "largest_disagreement",
        "failure_region_2022"
      ],
      "n_per_category": 5,
      "deterministic_seed": 42
    }
  },
  "explanation_methods": {
    "global": {
      "linear": [
        "coefficients",
        "permutation_importance",
        "standardized_coefficients"
      ],
      "tree": [
        "permutation_importance"
      ],
      "all": [
        "permutation_importance"
      ]
    },
    "local": {
      "methods": [
        "shap_linear",
        "permutation_local",
        "sensitivity_analysis",
        "counterfactual_threshold"
      ],
      "shap_backend": "KernelExplainer with deterministic seed",
      "reference_value": "training_set_mean"
    },
    "counterfactual": {
      "max_iterations": 100,
      "step_size": 0.05,
      "domain_bounds": "observed_min_max_per_feature",
      "target_change": 0.1
    }
  },
  "synthetic_validation_models": [
    {
      "id": "SYNTH-001",
      "type": "single_feature",
      "formula": "y = 2.0 * X1 + noise",
      "n_features": 10,
      "informative": [
        "X1"
      ],
      "expected": "X1 dominates attribution"
    },
    {
      "id": "SYNTH-002",
      "type": "linear",
      "formula": "y = 1.5*X1 - 0.8*X2 + 0.5*X3 + noise",
      "n_features": 10,
      "informative": [
        "X1",
        "X2",
        "X3"
      ],
      "expected": "attribution ordering matches coefficients under scaling"
    },
    {
      "id": "SYNTH-003",
      "type": "interaction",
      "formula": "y = X1 * X2 + noise",
      "n_features": 10,
      "informative": [
        "X1",
        "X2"
      ],
      "expected": "interaction dependence identified"
    },
    {
      "id": "SYNTH-004",
      "type": "redundant",
      "formula": "y = 1.0 * X1 + noise, X2 = X1 + 0.01*noise",
      "n_features": 10,
      "informative": [
        "X1"
      ],
      "expected": "instability or attribution sharing detected"
    },
    {
      "id": "SYNTH-005",
      "type": "noise_features",
      "formula": "y = 1.0 * X1 + noise, 9 noise features",
      "n_features": 10,
      "informative": [
        "X1"
      ],
      "expected": "noise importance remains low"
    }
  ],
  "stability_tests": {
    "permutation_stability": {
      "n_repeats": 30,
      "threshold": "rank_correlation > 0.9"
    },
    "sensitivity_perturbation": {
      "n_perturbations": 100,
      "perturbation_range": "0.5x to 2.0x feature std",
      "cliff_threshold": "prediction_delta > 3x baseline_std"
    },
    "counterfactual_stability": {
      "n_runs": 10,
      "threshold": "same feature identified >= 80%"
    }
  },
  "faithfulness_tests": {
    "deletion": {
      "method": "neutralize_top_k_features",
      "k_values": [
        1,
        2,
        3,
        5
      ],
      "neutralization": "set to training_mean"
    },
    "insertion": {
      "method": "add_features_by_rank",
      "k_values": [
        1,
        2,
        3,
        5
      ],
      "baseline": "all_features_at_training_mean"
    },
    "metric": "rank_correlation_between_attribution_and_ablation_impact",
    "thresholds": {
      "FAITHFUL": "> 0.7",
      "PARTIALLY_FAITHFUL": "> 0.4",
      "WEAK": "> 0.1",
      "MISLEADING": "<= 0.1"
    }
  },
  "provenance_audit_tests": [
    "A1_wrong_model_version",
    "A2_feature_value_mismatch",
    "A3_feature_snapshot_mutation",
    "A4_future_feature_injection",
    "A5_timestamp_before_availability",
    "A6_id_substitution",
    "A7_registry_evidence_mismatch",
    "A8_missing_provenance",
