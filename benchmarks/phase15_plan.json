    "A12_failed_explanation_excluded"
  ],
  "acceptance_thresholds": {
    "synthetic_ground_truth": "all 5 synthetic models PASS",
    "faithfulness_deletion": "median rank_correlation >= 0.4",
    "faithfulness_insertion": "median rank_correlation >= 0.4",
